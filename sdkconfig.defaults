# M5Stack PaperS3 hardware
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Paperboy needs the full ESP32-S3 clock and release optimization to sustain
# the emulator and high-refresh EPD pipeline in real time.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Preserve ROM names on FAT volumes. Heap-backed LFN avoids putting the FATFS
# maximum filename buffer on each recursive directory scan's task stack.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
